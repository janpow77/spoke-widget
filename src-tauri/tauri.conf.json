{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spoke Widget",
  "version": "0.1.0",
  "identifier": "io.janpow.spokewidget",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Spoke Widget - Settings",
        "url": "index.html",
        "width": 480,
        "height": 360,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "skipTaskbar": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:*"
    },
    "trayIcon": {
      "iconPath": "icons/tray-unknown.png",
      "iconAsTemplate": false,
      "tooltip": "Spoke Widget"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 Jan Riener",
    "shortDescription": "Tray widget for spoke-agent / Spoke-Stack",
    "longDescription": "Cross-platform system-tray frontend for the spoke-agent. Provides quick access to the Spoke-Stack dashboard and shows the live connection status to the llm-router.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/tray-green.png",
      "icons/tray-yellow.png",
      "icons/tray-red.png",
      "icons/tray-grey.png",
      "icons/tray-unknown.png"
    ],
    "targets": "all",
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": ["en-US"]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": "^https?://"
    }
  }
}
